{
  "name": "calebketterer-github-io",
  "version": "0.0.0",
  "main": "electron-main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "deploy": "ng build --configuration production && npx angular-cli-ghpages --dir=dist/calebketterer.github.io/browser",
    "postbuild": "node audit-components.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "wholetree": "find . -maxdepth 5 -not -path \"*/.*\" -not -path \"./.angular*\" -not -path \"./.vscode*\" -not -path \"./dist*\" -not -path \"./node_modules*\" | sed -e \"s/[^-][^\\/]*\\// |/g\" -e \"s/|\\([^ ]\\)/|-\\1/\"",
    "apptree": "find src/app -maxdepth 5 -not -path \"src/app/games/*/*\" -not -path \"src/app/pages/*/*\" -not -path \"*/.*\" | sed -e \"s/[^-][^\\/]*\\// |/g\" -e \"s/|\\([^ ]\\)/|-\\1/\"",
    "diepapptree": "find src/app/games/diep -not -path \"*/.*\" | sed -e \"s/[^-][^\\/]*\\// |/g\" -e \"s/|\\([^ ]\\)/|-\\1/\"",
    "snakeapptree": "find src/app/games/snake -not -path \"*/.*\" | sed -e \"s/[^-][^\\/]*\\// |/g\" -e \"s/|\\([^ ]\\)/|-\\1/\"",
    
    "electron:dev": "ng build && electron electron-main.js",
    "build:hub": "ng build --configuration production && electron-builder",
    "build:snake": "TARGET_GAME=snake ng build --configuration production && electron-builder -mwl",
    "build:sudoku": "TARGET_GAME=sudoku ng build --configuration production && electron-builder",
    "build:diep": "TARGET_GAME=diep ng build --configuration production && electron-builder"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "angular-cli-ghpages": "^2.0.3",
    "ng": "^0.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.4",
    "@angular/cli": "^18.2.4",
    "@angular/compiler-cli": "^18.2.0",
    "@types/jasmine": "~5.1.0",
    "cross-env": "^10.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.5.2"
  },
  "build": {
    "appId": "com.calebketterer.games",
    "productName": "Caleb Ketterer Games",
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "electron-main.js"
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"]
    },
    "mac": {
      "target": ["dmg"]
    }
  }
}
